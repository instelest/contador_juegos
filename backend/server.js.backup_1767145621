// ------------------------------------------------------
// Contador automático con audio
// ------------------------------------------------------
setInterval(() => {
  Object.values(estado.contadores).forEach(contador => {
    if (contador.contadorActivo && contador.tiempoRestante > 0) {
      contador.tiempoRestante--;
      
      if (contador.audio.archivo && !contador.audio.reproduciendo) {
        // Modo manual con offset - reproducir cuando quedan X segundos
        if (contador.audio.modo === 'manual') {
          const offset = contador.audio.offset || 0;
          if (contador.tiempoRestante === offset) {
            contador.audio.reproduciendo = true;
          }
        }
        // Modo automático - reproducir para que termine con el contador
        else if (contador.audio.modo === 'automatico') {
          if (contador.tiempoRestante === contador.audio.duracion) {
            contador.audio.reproduciendo = true;
          }
        }
      }
      
      if (contador.tiempoRestante === 0) {
        contador.tiempoFinalizacion = Date.now();
        if (contador.audio.archivo && contador.audio.modo === 'final') {
          contador.audio.reproduciendo = true;
        }
      }
    } else if (contador.contadorActivo && contador.tiempoRestante <= 0) {
      contador.contadorActivo = false;
    }
  });
}, 1000);

