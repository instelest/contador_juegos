// Listar todos los audios en la biblioteca
app.get('/api/biblioteca/audios', async (req, res) => {
  try {
    const dir = path.join(__dirname, 'archivos', 'audios');
    if (!fs.existsSync(dir)) {
      return res.json({ audios: [] });
    }

    const archivos = fs.readdirSync(dir).filter(f => 
      f.endsWith('.mp3') || f.endsWith('.wav') || f.endsWith('.ogg') || f.endsWith('.m4a')
    );

    const audios = [];
    for (const archivo of archivos) {
      const filePath = path.join(dir, archivo);
      const stats = fs.statSync(filePath);
      try {
        const duracion = await getAudioDurationInSeconds(filePath);
        audios.push({
          nombre: archivo,
          archivo: archivo,
          duracion: Math.ceil(duracion),
          tamaño: stats.size,
          fecha: stats.mtime
        });
      } catch (e) {
        audios.push({
          nombre: archivo,
          archivo: archivo,
          duracion: 0,
          tamaño: stats.size,
          fecha: stats.mtime
        });
      }
    }

    res.json({ audios });
  } catch (error) {
    console.error('Error listando audios:', error);
    res.status(500).json({ audios: [] });
  }
});

