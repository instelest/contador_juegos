app.post('/api/upload-audio', uploadAudio.single('audio'), async (req, res) => {
  try {
    if (!req.file) {
      return res.status(400).json({ success: false, message: 'No se subió archivo' });
    }

    const modo = req.body.modo || 'final';
    const nombre = req.body.nombre || req.file.originalname;
    const offset = parseInt(req.body.offset) || 0;
    const filePath = req.file.path;
    const duracion = await getAudioDurationInSeconds(filePath);
    
    const contador = getContador();
    contador.audio = {
      archivo: req.file.filename,
      nombre: nombre,
      duracion: Math.ceil(duracion),
      modo: modo,
      offset: offset,
      reproduciendo: false
    };
    
    marcarCambio();
    res.json({ success: true, duracion: Math.ceil(duracion), modo: modo, offset: offset, nombre: nombre });
  } catch (error) {
    console.error('Error procesando audio:', error);
    res.status(500).json({ success: false, message: 'Error procesando audio' });
  }
});

app.delete('/api/audio', (req, res) => {
  const contador = getContador();
  if (contador.audio.archivo) {
    const filePath = path.join(__dirname, 'archivos', 'audios', contador.audio.archivo);
    if (fs.existsSync(filePath)) {
      fs.unlinkSync(filePath);
    }
  }
  contador.audio = { archivo: null, nombre: "Sin audio", duracion: 0, modo: 'final', offset: 0, reproduciendo: false };
  marcarCambio();
  res.json({ success: true });
});

